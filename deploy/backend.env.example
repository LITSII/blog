# /etc/blog/backend.env 로 복사 후 값 채우기 (chmod 600). 실제 값은 절대 커밋하지 말 것.

# OCI Autonomous DB
DB_SERVICE=blogdb_low
DB_WALLET_PATH=/opt/blog/wallet
DB_USERNAME=BLOG_APP
DB_PASSWORD=

# 관리자 계정 (비밀번호는 BCrypt 해시, 앞에 {bcrypt} 접두사)
# 해시 생성 예: htpasswd -bnBC 10 "" '비밀번호' | tr -d ':\n' | sed 's/^\$2y/$2a/'
ADMIN_USERNAME=admin
# $ 문자가 들어가므로 작은따옴표로 감쌀 것
ADMIN_PASSWORD_HASH='{bcrypt}$2a$10$...'

# HTTPS 적용 전 HTTP로 테스트할 때만 false
COOKIE_SECURE=true
